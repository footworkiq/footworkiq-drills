{
  "_source": "derived from docs/schema/drill.schema.json — keep in lockstep when schema changes",
  "name": "drill",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "metadata", "sequence"],
    "properties": {
      "schema": {
        "type": "string",
        "const": "1.0"
      },
      "metadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "contributor",
          "difficulty",
          "default_bpm",
          "tags",
          "description",
          "time_signature",
          "count_in",
          "reps",
          "sets",
          "rest_beats",
          "subdivision",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "contributor": {
            "type": "string",
            "const": "FootworkIQ-AI"
          },
          "difficulty": {
            "type": "string",
            "enum": ["Beginner", "Intermediate", "Advanced"]
          },
          "default_bpm": {
            "type": "integer",
            "minimum": 40,
            "maximum": 240
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "description": {
            "type": "string"
          },
          "time_signature": {
            "type": "string",
            "pattern": "^[0-9]+/[0-9]+$"
          },
          "count_in": {
            "type": "integer",
            "minimum": 0
          },
          "reps": {
            "type": "integer",
            "minimum": 1
          },
          "sets": {
            "type": "integer",
            "minimum": 1
          },
          "rest_beats": {
            "type": "integer",
            "minimum": 0
          },
          "subdivision": {
            "type": "integer",
            "enum": [1, 2, 4]
          },
          "license": {
            "type": "string",
            "enum": ["CC0"]
          }
        }
      },
      "sequence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["beat", "left_foot", "right_foot", "ball"],
          "properties": {
            "beat": {
              "type": "integer",
              "minimum": 1
            },
            "left_foot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pos", "action"],
              "properties": {
                "pos": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "PLANT",
                    "STEP",
                    "INSIDE_TOUCH",
                    "OUTSIDE_TOUCH",
                    "SOLE_ROLL",
                    "TAP",
                    "DRAG",
                    "STEP_OVER",
                    "LIFT"
                  ]
                }
              }
            },
            "right_foot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pos", "action"],
              "properties": {
                "pos": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "PLANT",
                    "STEP",
                    "INSIDE_TOUCH",
                    "OUTSIDE_TOUCH",
                    "SOLE_ROLL",
                    "TAP",
                    "DRAG",
                    "STEP_OVER",
                    "LIFT"
                  ]
                }
              }
            },
            "ball": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pos", "action", "from", "to"],
              "properties": {
                "pos": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "action": {
                  "type": "string",
                  "enum": ["STILL", "ROLL", "PUSH", "LIFT"]
                },
                "from": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "to": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                }
              }
            }
          }
        }
      }
    }
  }
}
